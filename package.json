{
  "name": "scos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared-types": {
      "types": "./src/shared-types/index.ts",
      "default": "./dist/shared-types/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "./scripts/test-integration.sh",
    "postman:generate": "node scripts/generate-postman.mjs",
    "postman:check": "node scripts/generate-postman.mjs --check",
    "db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.test.yml down",
    "db:migrate": "DATABASE_URL=postgresql://scos_test:scos_test@localhost:5433/scos_test prisma migrate deploy",
    "db:seed": "DATABASE_URL=postgresql://scos_test:scos_test@localhost:5433/scos_test prisma db seed",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@prisma/client": "^6.9.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "openapi-to-postmanv2": "^6.3.3",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
