{
  "info": {
    "_postman_id": "c8b4a1d2-5e6f-4a7b-9c8d-1e2f3a4b5c6d",
    "name": "SCOS Order Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "API for managing SCOS Station P1 Pro orders with multi-warehouse fulfillment",
      "type": "text/plain"
    }
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "quantity",
      "value": "10",
      "type": "string"
    },
    {
      "key": "latitude",
      "value": "34.0",
      "type": "string"
    },
    {
      "key": "longitude",
      "value": "-118.0",
      "type": "string"
    },
    {
      "key": "orderNumber",
      "value": "ORD-000001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Orders",
      "item": [
        {
          "name": "Submit order",
          "request": {
            "name": "Submit an order",
            "description": {
              "content": "Persist an order with transactional stock decrement",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "orders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [],
              "raw": "{{baseUrl}}/api/orders"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": {{quantity}},\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Order number is returned', function () {",
                  "    pm.expect(body.orderNumber).to.match(/^ORD-\\d{6,}$/);",
                  "    pm.expect(body.quote).to.be.an('object');",
                  "});",
                  "",
                  "pm.collectionVariables.set('orderNumber', body.orderNumber);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify order quote",
          "request": {
            "name": "Verify an order quote",
            "description": {
              "content": "Calculate pricing, discount, shipping, and fulfillment plan without persisting",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "orders",
                "verify"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [],
              "raw": "{{baseUrl}}/api/orders/verify"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": {{quantity}},\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Quote contains a fulfillment plan', function () {",
                  "    pm.expect(body).to.have.property('valid');",
                  "    pm.expect(body.fulfillmentPlan).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order details",
          "request": {
            "name": "Get order details",
            "url": {
              "path": [
                "api",
                "orders",
                "{{orderNumber}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [],
              "raw": "{{baseUrl}}/api/orders/{{orderNumber}}"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Order details contain fulfillment lines', function () {",
                  "    pm.expect(body.orderNumber).to.eql(pm.collectionVariables.get('orderNumber'));",
                  "    pm.expect(body.lines).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Warehouses",
      "item": [
        {
          "name": "List warehouses and stock",
          "request": {
            "name": "List warehouses with current stock",
            "url": {
              "path": [
                "api",
                "warehouses"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [],
              "raw": "{{baseUrl}}/api/warehouses"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Warehouse stock list is returned', function () {",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(body[0]).to.have.property('stock').that.is.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
